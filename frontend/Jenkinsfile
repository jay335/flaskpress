pipeline {
    agent any

    environment {
        APP_DIR = "frontend"
        APP_NAME = "express-frontend"
    }

    options {
        timestamps()
        skipDefaultCheckout()
        durabilityHint('PERFORMANCE_OPTIMIZED')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Environment') {
            steps {
                dir(APP_DIR) {
                    sh '''
                    if [ ! -d "node_modules" ]; then
                        npm install
                    else
                        echo "Dependencies already installed. Skipping npm install."
                    fi
                    '''
                }
            }
        }

        stage('Restart App if Needed') {
            steps {
                dir(APP_DIR) {
                    sh '''
                    CHANGED=$(git diff --name-only HEAD~1 HEAD | grep -c '^')
                    if [ "$CHANGED" -gt 0 ]; then
                        pm2 restart ${APP_NAME} || pm2 start app.js --name ${APP_NAME}
                        echo "Changes detected. App restarted."
                    else
                        echo "No code changes. Skipping restart."
                    fi
                    '''
                }
            }
        }
    }
}

